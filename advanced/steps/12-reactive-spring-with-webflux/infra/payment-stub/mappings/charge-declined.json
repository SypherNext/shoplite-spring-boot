{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/charges",
    "bodyPatterns": [
      { "matchesJsonPath": "$[?(@.amount > 500)]" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "paymentId": "pay_{{randomValue length=12 type='ALPHANUMERIC'}}",
      "status": "DECLINED"
    }
  }
}
